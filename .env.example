# Crea tu clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
PORT=5000

# Orígenes WordPress autorizados, separados por comas. Sin rutas ni comodines.
# Ejemplo local: http://127.0.0.1:8080,http://localhost:8080
# En producción, reemplaza estos ejemplos por el origen HTTPS real de WordPress.
ALLOWED_ORIGINS=
# /chat permite 30 preguntas por minuto e IP de conexión, en memoria por proceso.
# No se confía en X-Forwarded-For. Antes de usar un proxy en producción,
# configura explícitamente los proxies de confianza y un límite compartido si escalas.

# WhatsApp Cloud API (Meta). Completa estos valores solo en .env.
# Inventado por el equipo; se repite en la configuración del webhook de Meta.
WHATSAPP_VERIFY_TOKEN=
# Token de acceso del panel de WhatsApp / API Setup.
WHATSAPP_ACCESS_TOKEN=
# Identificador del número de prueba; no es el número telefónico ni el WABA ID.
WHATSAPP_PHONE_NUMBER_ID=
# Secreto de la aplicación Meta; autentica los eventos POST del webhook.
META_APP_SECRET=
# Versión de referencia configurable; confirma la admitida por tu app en Meta.
WHATSAPP_API_VERSION=v23.0
